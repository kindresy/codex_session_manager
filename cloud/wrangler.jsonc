{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-session-cloud",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-26",
  "r2_buckets": [
    {
      "binding": "SESSIONS",
      "bucket_name": "codex-session-history"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
